# .env.example — copy this file to .env and fill in your credentials.
# The .env file is loaded automatically by Docker Compose.
#
# NEVER commit the populated .env file to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Bearer token from Beeper Desktop.
# To obtain it: open Beeper Desktop, go to Settings → Developer, and copy
# the access token.  Alternatively, run the macOS app once; it stores the
# token in Keychain and prints it in the Xcode console on launch.
BEEPER_TOKEN=your_beeper_token_here

# ── Optional ──────────────────────────────────────────────────────────────────

# URL where Beeper Desktop is running.
# Default is http://host.docker.internal:23373 which works when Beeper is
# running on the same machine as Docker.
# For remote Beeper instances, set this to the host's IP or hostname.
# BEEPER_BASE_URL=http://host.docker.internal:23373

# Maximum number of messages to fetch per chat during a sync.
# Lower values speed up the initial sync at the cost of less complete analytics.
# Remove or leave empty for unlimited (may take several minutes on large accounts).
# DEEPER_MESSAGE_LIMIT=500

# HTTP server bind address and port inside the container.
# PORT=8080
# HOST=0.0.0.0
